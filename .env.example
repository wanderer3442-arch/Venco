# VencoFit env — copy to .env and fill
DATABASE_URL="file:./dev.db"
# On Vercel Postgres: DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# NextAuth — generate with: npx auth secret  or  openssl rand -base64 32
AUTH_SECRET="replace-with-32-char-random"
NEXTAUTH_URL="http://localhost:3000"

# Gmail OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenRouter V chatbot
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
